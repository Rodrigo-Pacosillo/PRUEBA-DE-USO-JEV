// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Sugerencia {
  id      Int      @id @default(autoincrement())
  nombre  String
  tipo    String
  mensaje String
  fecha   DateTime @default(now())

  // Clasificacion automatica con Jev. Todos opcionales: la sugerencia se
  // guarda aunque el analisis falle o no se haya ejecutado.
  categoria         String?
  utilidad          Float?
  coincideTipo      Boolean?
  destacado         Boolean   @default(false)
  requiereRevision  Boolean?
  confianza         Float?
  estadoAnalisis    String   @default("pendiente")
  jevRequestId      String?
  jevCosto          Float?
  jevCrudo          String?
}


